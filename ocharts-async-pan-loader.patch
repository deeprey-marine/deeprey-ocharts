+// GUI-thread completion of an async load (called from the load manager's
+// CallAfter trampoline after the worker phase finished for a still-live chart).
+void eSENCChart::FinishAsyncLoad( ChartLoadJob& job )
+{
+    if(job.ingestResult == ERROR_SENC_EXPIRED){
+        // Hard expiry: surface the dialog now that the worker has the day counts,
+        // and render blank. Stay "ready" so core does not delete-and-reopen us.
+        m_uSENCExpireDaysRemaining = job.expireDaysRemaining;
+        m_uSENCGraceDaysAllowed    = job.graceDaysAllowed;
+        m_uSENCGraceDaysRemaining  = job.graceDaysRemaining;
+        ShowExpiredErrorMessage(m_FullPath, m_uSENCExpireDaysRemaining,
+                                m_uSENCGraceDaysRemaining, m_uSENCGraceDaysAllowed);
+        m_bLoadFailedPermanent = true;
+        m_bDataReady           = false;
+        m_bReadyToRender       = true;
+        return;
+    }
+
+    if(job.ingestResult != SENC_NO_ERROR){
+        // Other failure (signature / corrupt / cancelled cell): render blank, stay
+        // ready so core does not delete-and-reopen and busy-loop on the decode.
+        m_bLoadFailedPermanent = true;
+        m_bDataReady           = false;
+        m_bReadyToRender       = true;
+        return;
+    }
+
+    BuildRAZ_MainPhase( job );        // copies metadata + ps52plib LUP walk + assembly
+    SetColorScheme( job.colorScheme, false );
+    BuildDepthContourArray();
+
+    // Soft "expires soon" warning, now that expiry counts are populated.
+    ShowExpiredErrorMessage(m_FullPath, m_uSENCExpireDaysRemaining,
+                            m_uSENCGraceDaysRemaining, m_uSENCGraceDaysAllowed);
+
+    m_bDataReady     = true;
+    m_bReadyToRender = true;
+
+    RequestRefresh( GetOCPNCanvasWindow() );
 }
 
 
