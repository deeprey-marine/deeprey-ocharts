diff --git a/src/eSENCChartLoadManager.cpp b/src/eSENCChartLoadManager.cpp
new file mode 100644
index 0000000..dd94800
--- /dev/null
+++ b/src/eSENCChartLoadManager.cpp
@@ -0,0 +1,123 @@
+/******************************************************************************
+ * Async o-chart load manager implementation. See eSENCChartLoadManager.h.
+ ******************************************************************************/
+
+#include "wx/wxprec.h"
+#ifndef WX_PRECOMP
+  #include "wx/wx.h"
+#endif
+#include <wx/app.h>
+
+#include "eSENCChartLoadManager.h"
+
+eSENCChartLoadManager* g_chartLoadManager = NULL;
+
+// Runs on the GUI thread (via CallAfter). Completes the load for a still-live chart.
+void eSENCChartLoadManager::MainPhaseTrampoline(std::shared_ptr<ChartLoadJob> job)
+{
+    if(job->state->cancelled.load())
+        return;                                   // chart was deleted; no-op
+    eSENCChart* chart = job->state->chart.load(); // GUI-thread read
+    if(!chart)
+        return;
+    chart->FinishAsyncLoad(*job);
+}
+
+eSENCChartLoadManager::eSENCChartLoadManager()
+    : m_shutdown(false), m_started(false)
+{
+}
+
+eSENCChartLoadManager::~eSENCChartLoadManager()
+{
+    Stop();
+}
+
+void eSENCChartLoadManager::Start()
+{
+    if(m_started)
+        return;
+    m_shutdown = false;
+    m_started  = true;
+    m_worker   = std::thread(&eSENCChartLoadManager::WorkerLoop, this);
+}
+
+void eSENCChartLoadManager::Stop()
+{
+    if(!m_started)
+        return;
+    {
+        std::lock_guard<std::mutex> lk(m_mtx);
+        m_shutdown = true;
+    }
+    m_cv.notify_all();
+    if(m_worker.joinable())
+        m_worker.join();
+    m_started = false;
+}
+
+void eSENCChartLoadManager::Enqueue(std::shared_ptr<ChartLoadJob> job)
+{
+    {
+        std::lock_guard<std::mutex> lk(m_mtx);
+        m_queue.push_back(job);
+    }
+    m_cv.notify_one();
+}
+
+void eSENCChartLoadManager::CancelAndWait(const std::shared_ptr<JobState>& st)
+{
+    std::unique_lock<std::mutex> lk(m_mtx);
+    st->cancelled.store(true);
+
+    // Drop it if still queued (not yet picked up by the worker).
+    for(auto it = m_queue.begin(); it != m_queue.end(); ){
+        if((*it)->state == st)
+            it = m_queue.erase(it);
+        else
+            ++it;
+    }
+
+    // If the worker is currently inside this job's worker phase (writing chart
+    // members), wait until it finishes before the caller frees those members.
+    while(m_activeState == st)
+        m_doneCv.wait(lk);
+}
+
+void eSENCChartLoadManager::WorkerLoop()
+{
+    for(;;){
+        std::shared_ptr<ChartLoadJob> job;
+        {
+            std::unique_lock<std::mutex> lk(m_mtx);
+            m_cv.wait(lk, [this]{ return m_shutdown || !m_queue.empty(); });
+            if(m_shutdown && m_queue.empty())
+                return;
+            if(m_queue.empty())
+                continue;
+            job = m_queue.front();
+            m_queue.pop_front();
+            if(job->state->cancelled.load())
+                continue;                    // cancelled while queued
+            m_activeState = job->state;      // mark active under the lock
+        }
+
+        // Blocking decrypt + parse, off the GUI thread. Writes only this chart's
+        // members; safe because CancelAndWait blocks ~eSENCChart until we clear
+        // m_activeState below, so the chart cannot be freed under us.
+        eSENCChart* chart = job->state->chart.load();
+        if(chart && !job->state->cancelled.load())
+            chart->BuildRAZ_WorkerPhase(*job, false /* no GUI on worker thread */);
+
+        {
+            std::lock_guard<std::mutex> lk(m_mtx);
+            m_activeState.reset();           // worker phase done for this job
+        }
+        m_doneCv.notify_all();               // wake any waiting destructor
+
+        if(job->state->cancelled.load())
+            continue;                        // chart died during decrypt; discard
+
+        wxTheApp->CallAfter([job]{ eSENCChartLoadManager::MainPhaseTrampoline(job); });
+    }
+}
diff --git a/src/eSENCChartLoadManager.h b/src/eSENCChartLoadManager.h
new file mode 100644
index 0000000..b597928
--- /dev/null
+++ b/src/eSENCChartLoadManager.h
@@ -0,0 +1,58 @@
+/******************************************************************************
+ * Async o-chart load manager.
+ *
+ * Runs the blocking oexserverd decrypt + SENC parse (eSENCChart::BuildRAZ_WorkerPhase)
+ * on a single background worker thread, then marshals the GUI-thread finalize
+ * (BuildRAZ_MainPhase + refresh) back via wxApp::CallAfter. One worker by design:
+ * it serializes oexserverd access and the shared pi_poRegistrarMgr, and sidesteps
+ * the (unverified) question of whether the daemon serves concurrent requests.
+ ******************************************************************************/
+
+#ifndef _ESENCCHARTLOADMANAGER_H_
+#define _ESENCCHARTLOADMANAGER_H_
+
+#include <thread>
+#include <mutex>
+#include <condition_variable>
+#include <deque>
+#include <memory>
+#include <atomic>
+
+#include "eSENCChart.h"     // ChartLoadJob, JobState, eSENCChart
+
+class eSENCChartLoadManager {
+public:
+    eSENCChartLoadManager();
+    ~eSENCChartLoadManager();
+
+    void Start();
+    void Stop();
+
+    // GUI thread: enqueue an async load. Returns immediately.
+    void Enqueue(std::shared_ptr<ChartLoadJob> job);
+
+    // GUI thread (from ~eSENCChart): cancel this load. Drops it if still queued,
+    // and blocks until the worker is no longer inside this job's worker phase, so
+    // the caller may then safely free the chart's members.
+    void CancelAndWait(const std::shared_ptr<JobState>& st);
+
+    // GUI-thread completion (posted via CallAfter). Static so it needs no manager
+    // instance and is safe to fire after the manager is torn down.
+    static void MainPhaseTrampoline(std::shared_ptr<ChartLoadJob> job);
+
+private:
+    void WorkerLoop();
+
+    std::thread               m_worker;
+    std::mutex                m_mtx;
+    std::condition_variable   m_cv;       // queue-not-empty / shutdown
+    std::condition_variable   m_doneCv;   // worker finished a job's worker phase
+    std::deque<std::shared_ptr<ChartLoadJob>> m_queue;
+    std::shared_ptr<JobState> m_activeState;   // job currently in its worker phase (else null)
+    std::atomic<bool>         m_shutdown;
+    bool                      m_started;        // GUI-thread only (Init/DeInit serialized)
+};
+
+extern eSENCChartLoadManager* g_chartLoadManager;
+
+#endif  // _ESENCCHARTLOADMANAGER_H_
