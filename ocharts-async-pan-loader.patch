+struct JobState {
+    std::atomic<bool>          cancelled;
+    std::atomic<eSENCChart*>   chart;   // nulled by ~eSENCChart; read by worker/trampoline
+    JobState(eSENCChart* c) : cancelled(false), chart(c) {}
