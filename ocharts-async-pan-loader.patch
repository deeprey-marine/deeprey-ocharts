From 3c29f4962c6965d845047d61d5ca9c6d62da4f4b Mon Sep 17 00:00:00 2001
From: bensasl2 <ben@deeprey.com>
Date: Tue, 2 Jun 2026 11:34:54 +0100
Subject: [PATCH 1/2] Osenc: fix Linux decrypt EOF busy-poll and read() size_t
 underflow

---
 src/Osenc.cpp | 43 +++++++++++++++++++++++++++++++++----------
 1 file changed, 33 insertions(+), 10 deletions(-)

diff --git a/src/Osenc.cpp b/src/Osenc.cpp
index de9edbe..8bc87e9 100644
--- a/src/Osenc.cpp
+++ b/src/Osenc.cpp
@@ -32,6 +32,9 @@
 
 #include <wx/wfstream.h>
 #include <wx/filename.h>
+#include <wx/stopwatch.h>
+
+#include <errno.h>
 
 #include "Osenc.h"
 #include "s52s57.h"
@@ -518,20 +521,33 @@ Osenc_instream &Osenc_instream::Read(void *buffer, size_t size)
             do{
                 size_t bytes_to_read = MIN(remains, max_read);
 
-                size_t bytesRead = read(privatefifo, bufRun, bytes_to_read );
+                // NOTE: read() returns ssize_t. Storing it in an unsigned size_t
+                // made a -1 (error) wrap to SIZE_MAX and corrupt remains/bufRun.
+                ssize_t bytesRead = read(privatefifo, bufRun, bytes_to_read );
 
-                // Server may not have opened the Write end of the FIFO yet
-                if(bytesRead == 0){
-//                    printf("miss %d %d %d\n", nLoop, bytes_to_read, size);
+                if(bytesRead > 0){
+                    remains -= bytesRead;
+                    bufRun += bytesRead;
+                    totalBytesRead += bytesRead;
+                    nLoop = MAX_TRIES;          // made progress, reset retry budget
+                }
+                else if(bytesRead == 0){
+                    // EOF. The private FIFO is opened blocking (O_RDONLY, no
+                    // O_NONBLOCK), so read() returns 0 only once the server has
+                    // closed the write end, i.e. genuine end-of-stream. The old
+                    // code mistook this for "server not ready yet" and spun
+                    // MAX_TRIES * wxMilliSleep(1) (~100 ms) at the tail of every
+                    // decrypted cell. Stop immediately instead.
+                    break;
+                }
+                else {
+                    // read() error. Retry transient interruptions, otherwise back
+                    // off under a bounded budget rather than spin or corrupt counts.
+                    if(errno == EINTR)
+                        continue;
                     nLoop --;
                     wxMilliSleep(1);
                 }
-                else
-                    nLoop = MAX_TRIES;
-
-                remains -= bytesRead;
-                bufRun += bytesRead;
-                totalBytesRead += bytesRead;
             } while( (remains > 0) && (nLoop) );
 
             m_OK = (totalBytesRead == size);
@@ -1251,6 +1267,10 @@ int Osenc::ingest200(const wxString &senc_file_name,
     wxFileName fn(senc_file_name);
     m_ID = fn.GetName();                          // This will be the NOAA File name, usually
 
+    // PERF instrumentation: measure full per-cell decrypt+parse wall-clock
+    // (FIFO handshake + verifySENC + record ingest). Grep the log for "OCHARTS_PERF".
+    wxStopWatch sw_ingest;
+
     //    Sanity check for existence of file
     if(!fn.Exists())
         return ERROR_SENCFILE_NOT_FOUND;
@@ -1960,6 +1980,9 @@ int Osenc::ingest200(const wxString &senc_file_name,
 
     if(g_debugLevel) wxLogMessage(_T("ingest200 SENC Ingested OK"));
 
+    if(g_debugLevel) wxLogMessage(_T("OCHARTS_PERF ingest200 cell=%s ms=%ld"),
+                 m_ID, sw_ingest.Time());
+
     return ret_val;
 
 }
-- 
